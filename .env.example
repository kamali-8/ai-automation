# Environment Configuration for Intern Management Automation Demo

# Local SQLite Database
DATABASE_URL="file:./dev.db"

# Session & JWT secret (for demo token signing)
JWT_SECRET="intern-automation-super-secret-key-for-local-demo-min-32-chars"

# Ollama Local AI Configuration
# Ollama must be running locally (e.g. `ollama serve` and `ollama run qwen2.5`)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:latest"

# Next.js Port
PORT=3000

